<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Group for users who can see the equipment-asset relationship -->
        <record id="group_equipment_asset_user" model="res.groups">
            <field name="name">See Equipment-Asset Relationship</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <!-- Record rule to limit access to equipment only to users with appropriate permissions -->
        <record id="rule_equipment_asset_visibility" model="ir.rule">
            <field name="name">Access to Equipment with Assets</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        </record>
    </data>
</odoo>