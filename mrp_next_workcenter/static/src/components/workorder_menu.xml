<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="mrp_workorder.MrpDisplayMenuDialog" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='moveToWorkcenter']" position="after">
            <button t-if="props.record.resModel == 'mrp.workorder'"
                    class="btn btn-outline-secondary d-flex justify-content-between align-items-center p-3 fs-3"
                    t-on-click="nextWorkcenter">
                        Next work center <i class="oi oi-chevron-right"/>
                    </button>
        </xpath>
    </t>
</templates>