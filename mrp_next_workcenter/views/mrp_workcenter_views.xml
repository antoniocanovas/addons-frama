<odoo>
    <record id="view_work_center_form_framajova_inherit" model="ir.ui.view">
        <field name="name">view.work.center.form.framajova.inherit</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <field name="next_workcenter_ids" widget="many2many_tags" />
                <field name="next_workcenter_id" domain="[('id', 'in', next_workcenter_ids)]"/>
            </xpath>
        </field>
    </record>
</odoo>